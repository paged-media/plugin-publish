{
  "kind": "struct",
  "fields": {
    "standard": { "kind": "enum", "members": ["pdf17", "pdfx4"], "default": "pdf17" },
    "pages": { "kind": "text", "maxLength": 32, "optional": true },
    "outputIntentProfile": { "kind": "text", "optional": true },
    "outputCondition": { "kind": "text", "optional": true },
    "colorPolicy": { "kind": "enum", "members": ["preserveNumbers", "convertToDestination"], "default": "preserveNumbers" },
    "cropMarks": { "kind": "bool", "default": false },
    "registrationMarks": { "kind": "bool", "default": false },
    "colorBars": { "kind": "bool", "default": false },
    "pageInfo": { "kind": "bool", "default": false },
    "marksOffset": { "kind": "length", "optional": true },
    "bleed": { "kind": "list", "of": { "kind": "length" }, "maxItems": 4, "optional": true },
    "downsamplePpi": { "kind": "number", "unit": "ppi", "optional": true },
    "effectDpi": { "kind": "number", "unit": "ppi", "default": 150 },
    "restrictedFontPolicy": { "kind": "enum", "members": ["outline", "fail"], "default": "outline" },
    "title": { "kind": "text", "optional": true }
  }
}
